// Cloudflare Workers — statyczna strona (bez kodu serwerowego).
// Build: `npm run build` → `dist/`, deploy: `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pmu-nivenora",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
