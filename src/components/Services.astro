---
import type { Dictionary } from '../i18n/pl';
import { prices, type PmuServiceId } from '../config/site';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const cur = t.services.currency;
// Kolejność: usta jako pierwsze (potencjalna usługa wiodąca), potem brwi i kreska.
const pmuOrder: PmuServiceId[] = ['usta', 'brwi', 'kreska'];
const stylingFrom = Math.min(...prices.styling.flatMap((g) => g.items.map((i) => i.price)));
---

<section class="section section--tint" id="cennik" aria-labelledby="cennik-title">
  <div class="container">
    <div class="section-head">
      <h2 id="cennik-title">{t.services.title}</h2>
      <p class="lead">{t.services.lead}</p>
    </div>

    <ul class="cards">
      {
        pmuOrder.map((id) => {
          const s = t.services.pmu[id];
          const p = prices.pmu[id];
          return (
            <li class="card">
              <h3>{s.name}</h3>
              <p class="card__desc">{s.description}</p>
              <dl class="card__prices">
                <div class="price-main">
                  <dt class="visually-hidden">{s.short}</dt>
                  <dd>
                    {p.price} <span>{cur}</span>
                  </dd>
                </div>
                <div class="price-corr">
                  <dt>{t.services.correction}</dt>
                  <dd>
                    {p.correction} {cur}
                  </dd>
                </div>
              </dl>
            </li>
          );
        })
      }
    </ul>

    <p class="corr-note">* {t.services.correctionNote(prices.correctionWithinMonths)}</p>

    <div class="packages">
      <h3>{t.services.packagesTitle}</h3>
      <ul class="price-list">
        {
          prices.pmuPackages.map((p) => (
            <li>
              <span>{t.services.packages[p.id]}</span>
              <span class="price">
                {p.price} {cur}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <details class="styling">
      <summary>
        <h3>{t.services.stylingTitle}</h3>
        <span class="styling__from">{t.services.stylingFrom} {stylingFrom} {cur}</span>
      </summary>
      <div class="styling__groups">
        {
          prices.styling.map((g) => (
            <div>
              <h4>{t.services.stylingGroups[g.group]}</h4>
              <ul class="price-list">
                {g.items.map((i) => (
                  <li>
                    <span>{t.services.styling[i.id]}</span>
                    <span class="price">
                      {i.price} {cur}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </details>
  </div>
</section>

<style>
  .cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  @media (min-width: 800px) {
    .cards {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }
  .card {
    background: var(--bg);
    border-radius: var(--radius);
    padding: 24px;
    display: flex;
    flex-direction: column;
  }
  .card h3 {
    margin-bottom: 8px;
  }
  .card__desc {
    color: var(--muted);
    font-size: 0.975rem;
    flex: 1;
  }
  .card__prices {
    margin: 8px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .card__prices dd {
    margin: 0;
  }
  .price-main dd {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
  }
  .price-main span {
    font-size: 1rem;
    color: var(--muted);
  }
  .price-corr {
    display: flex;
    gap: 6px;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .price-corr dt::after {
    content: '*:';
  }
  .corr-note {
    margin: 16px 0 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
  .packages {
    margin-top: 24px;
    background: var(--bg);
    border-radius: var(--radius);
    padding: 24px;
    max-width: 560px;
  }
  .packages h3,
  .styling h3 {
    font-size: 1.2rem;
  }
  .styling {
    margin-top: 16px;
    background: var(--bg);
    border-radius: var(--radius);
    padding: 0 24px;
    max-width: 560px;
  }
  .styling[open] {
    max-width: none;
    padding-bottom: 16px;
  }
  .styling summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 20px 0;
  }
  .styling summary::-webkit-details-marker {
    display: none;
  }
  .styling summary h3 {
    margin: 0;
  }
  .styling__from {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.9375rem;
    white-space: nowrap;
  }
  .styling summary::after {
    content: '+';
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1;
    color: var(--accent);
    transition: transform 0.2s ease;
  }
  .styling[open] summary::after {
    transform: rotate(45deg);
  }
  .styling__groups {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 800px) {
    .styling__groups {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }
  h4 {
    margin: 0 0 4px;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .price-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .price-list li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
  }
  .price-list li:last-child {
    border-bottom: 0;
  }
  .price {
    white-space: nowrap;
    font-weight: 600;
  }
</style>
