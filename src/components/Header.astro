---
import ContactButton from './ContactButton.astro';
import type { Dictionary } from '../i18n/pl';
import { site } from '../config/site';
import LangSwitcher from './LangSwitcher.astro';
import { localeMeta } from '../i18n/locales';
import Icon from './Icon.astro';

interface Props {
  t: Dictionary;
  page?: 'home' | 'privacy';
}
const { t, page = 'home' } = Astro.props;
// Na stronie głównej same kotwice (płynne przewijanie), na podstronach — link do strony głównej.
const base = page === 'home' ? '' : localeMeta[t.lang].path;
const links = [
  { href: `${base}#efekty`, label: t.nav.results },
  { href: `${base}#cennik`, label: t.nav.prices },
  { href: `${base}#o-mnie`, label: t.nav.about },
  { href: `${base}#faq`, label: t.nav.faq },
  { href: `${base}#kontakt`, label: t.nav.contact },
];
---

<header class="header">
  <div class="container header__inner">
    <a class="logo" href={localeMeta[t.lang].path} aria-label={site.brand}>
      Veronika <span>PMU</span>
    </a>
    <nav class="nav" aria-label={t.nav.menu}>
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    {
      site.contact.phone && (
        <a class="phone" href={`tel:${site.contact.phone.replace(/\s/g, '')}`} data-track="phone_click" data-track-location="header">
          <Icon name="phone" />
          {site.contact.phone}
        </a>
      )
    }
    <LangSwitcher current={t.lang} label={t.nav.language} page={page} />
    <ContactButton t={t} location="header" size="sm" label="short" />
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
  }
  .logo {
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .logo span {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    color: var(--muted);
    margin-left: 2px;
  }
  .nav {
    display: none;
  }
  .phone {
    display: none;
  }
  /* Numer telefonu w nagłówku tylko na dużych ekranach (na telefonie jest dolny pasek) */
  @media (min-width: 1360px) {
    .header__inner {
      max-width: 1320px;
    }
    .phone {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-left: 12px;
      color: var(--ink);
      text-decoration: none;
      font-size: 0.9375rem;
      font-weight: 600;
      white-space: nowrap;
    }
    .phone :global(svg) {
      width: 17px;
      height: 17px;
      color: var(--accent);
    }
  }
  .header__inner > :global(.lang) {
    margin-left: auto;
  }
  @media (min-width: 900px) {
    .header__inner > :global(.lang) {
      margin-left: 8px;
    }
  }
  @media (min-width: 1040px) {
    .nav {
      display: block;
      margin-left: auto;
    }
    .nav ul {
      display: flex;
      gap: clamp(16px, 1.8vw, 28px);
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .nav a {
      white-space: nowrap;
      color: var(--ink);
      text-decoration: none;
      font-size: 0.9375rem;
    }
    .nav a:hover {
      color: var(--accent);
    }
  }
  /* Na telefonie przycisk w nagłówku dubluje dolny pasek CTA — zostawiamy go tylko na szerokich ekranach */
  .header :global(.btn) {
    display: none;
  }
  @media (min-width: 900px) {
    .header :global(.btn) {
      display: inline-flex;
    }
  }
</style>
