---
import type { Dictionary } from '../i18n/pl';
import ContactButton from './ContactButton.astro';
interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section class="section final" aria-labelledby="final-title">
  <div class="container final__inner">
    <h2 id="final-title">{t.finalCta.title}</h2>
    <p class="lead">{t.finalCta.text}</p>
    <ContactButton t={t} location="final" />
  </div>
</section>

<style>
  .final__inner {
    text-align: center;
    max-width: 640px;
  }
  .final .lead {
    margin-bottom: 28px;
  }
</style>
