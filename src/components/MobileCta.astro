---
import type { Dictionary } from '../i18n/pl';
import ContactButton from './ContactButton.astro';
interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<div class="mobile-cta" data-mobile-cta>
  <ContactButton t={t} location="mobile-bar" />
</div>

<script>
  // Pasek chowa się, gdy przycisk w hero jest widoczny (bez JS pasek jest widoczny zawsze).
  const bar = document.querySelector<HTMLElement>('[data-mobile-cta]');
  const heroCta = document.querySelector('[data-hero-cta]');
  if (bar && heroCta && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => bar.classList.toggle('is-hidden', entry.isIntersecting)).observe(heroCta);
  }
</script>

<style>
  .mobile-cta {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--line);
  }
  .mobile-cta {
    transition: transform 0.25s ease;
  }
  .mobile-cta.is-hidden {
    transform: translateY(110%);
  }
  .mobile-cta :global(.btn) {
    width: 100%;
  }
  @media (min-width: 900px) {
    .mobile-cta {
      display: none;
    }
  }
</style>
