---
import type { Dictionary } from '../i18n/pl';
import ContactButton from './ContactButton.astro';
import Icon from './Icon.astro';
import { site, whatsappUrl } from '../config/site';
interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const waUrl = whatsappUrl(t.contact.whatsappMessage);
---

<div class="mobile-cta" data-mobile-cta>
  <ContactButton t={t} location="mobile-bar" label="short" class="mobile-cta__main" />
  {
    site.contact.phone && (
      <a
        class="btn btn--ghost mobile-cta__call"
        href={`tel:${site.contact.phone.replace(/\s/g, '')}`}
        aria-label={`${t.contact.call}: ${site.contact.phone}`}
        data-track="phone_click"
        data-track-location="mobile-bar"
      >
        <Icon name="phone" />
      </a>
    )
  }
  {
    waUrl && (
      <a
        class="btn btn--ghost mobile-cta__call"
        href={waUrl}
        target="_blank"
        rel="noopener"
        aria-label={t.contact.whatsapp}
        data-track="whatsapp_click"
        data-track-location="mobile-bar"
      >
        <Icon name="whatsapp" />
      </a>
    )
  }
</div>

<script>
  // Pasek chowa się, gdy przycisk w hero jest widoczny (bez JS pasek jest widoczny zawsze).
  const bar = document.querySelector<HTMLElement>('[data-mobile-cta]');
  const heroCta = document.querySelector('[data-hero-cta]');
  if (bar && heroCta && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => bar.classList.toggle('is-hidden', entry.isIntersecting)).observe(heroCta);
  }
</script>

<style>
  .mobile-cta {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    padding: 10px var(--gutter) calc(10px + env(safe-area-inset-bottom));
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-top: 1px solid var(--line);
  }
  .mobile-cta {
    transition: transform 0.25s ease;
  }
  .mobile-cta.is-hidden {
    transform: translateY(110%);
  }
  .mobile-cta {
    display: flex;
    gap: 8px;
    padding-inline: 12px;
  }
  .mobile-cta :global(.mobile-cta__main) {
    flex: 1;
    min-width: 0;
    padding-inline: 14px;
  }
  .mobile-cta__call {
    width: 48px;
    padding: 0;
    flex: none;
    background: var(--bg);
  }
  @media (min-width: 900px) {
    .mobile-cta {
      display: none;
    }
  }
</style>
