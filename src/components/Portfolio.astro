---
import { Image, getImage } from 'astro:assets';
import type { Dictionary } from '../i18n/pl';
import { portfolio, type PortfolioCategory } from '../config/portfolio';
import { site } from '../config/site';
import Icon from './Icon.astro';

interface Props {
  t: Dictionary;
  /** Tylko zdjęcia z tej kategorii (bez filtrów i bez „Pokaż więcej”). */
  category?: PortfolioCategory;
  title?: string;
  /** Pokazuj zdjęcia zamiast wideo (np. gdy to samo wideo jest już wyżej na stronie). */
  noVideo?: boolean;
}
const { t, category, title = t.portfolio.title, noVideo = false } = Astro.props;
const isDev = import.meta.env.DEV;

// Wygojone efekty zawsze na początku — to najlepszy dowód jakości.
const items = [...portfolio]
  .filter((p) => !category || p.categories.includes(category))
  .sort((a, b) => Number(b.stage === 'healed') - Number(a.stage === 'healed'));

const usedCategories = (['usta', 'brwi', 'kreska'] as PortfolioCategory[]).filter((c) =>
  items.some((i) => i.categories.includes(c)),
);

const thumbWidths = (w: number) => {
  const ws = [360, 540, 720].filter((x) => x < w);
  return [...ws, Math.min(w, 1080)];
};

// Wersja powiększona do podglądu (nigdy nie powiększamy ponad oryginał).
const large = await Promise.all(
  items.map((i) => getImage({ src: i.image, width: Math.min(i.image.width, 1400), format: 'webp' })),
);
// Na starcie widać tylko tyle zdjęć — reszta po kliknięciu „Pokaż więcej” (bez JS widać wszystkie).
const INITIAL_VISIBLE = category ? Infinity : 8;
const hasTempImages = items.some((i) => i.image.width < 600);
---

<section class="section" id="efekty" aria-labelledby="efekty-title">
  <div class="container">
    <div class="section-head">
      <h2 id="efekty-title">{title}</h2>
      {t.portfolio.lead && <p class="lead">{t.portfolio.lead}</p>}
      {isDev && hasTempImages && <p class="dev-flag">{t.dev.tempImages}</p>}
    </div>

    {
      !category && usedCategories.length > 1 && (
        <div class="filters" role="group" aria-label={t.portfolio.title} data-filters>
          <button type="button" aria-pressed="true" data-filter="all">
            {t.portfolio.filterAll}
          </button>
          {usedCategories.map((c) => (
            <button type="button" aria-pressed="false" data-filter={c}>
              {t.portfolio.categories[c]}
            </button>
          ))}
        </div>
      )
    }

    <ul class="gallery" data-gallery>
      {
        items.map((item, i) => (
          <li data-categories={item.categories.join(' ')} data-extra={i >= INITIAL_VISIBLE ? '' : undefined}>
            <button
              type="button"
              class="gallery__item"
              data-index={i}
              data-full={large[i].src}
              data-alt={item.alt[t.lang]}
              data-max={item.image.width * 2}
              data-video-mp4={noVideo ? undefined : item.video?.mp4}
              data-video-webm={noVideo ? undefined : item.video?.webm}
              data-video-poster={noVideo ? undefined : item.video?.poster}
              aria-label={`${t.portfolio.open}: ${item.alt[t.lang]}`}
            >
              {item.video && !noVideo ? (
                <>
                  {/* Wideo startuje dopiero, gdy kafelek jest widoczny (oszczędza transfer). */}
                  <video
                    class="gallery__video"
                    poster={item.video.poster}
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-label={item.alt[t.lang]}
                    data-inview-video
                  >
                    <source src={item.video.mp4} type="video/mp4" />
                    {item.video.webm && <source src={item.video.webm} type="video/webm" />}
                  </video>
                  <span class="play" aria-hidden="true">▶</span>
                </>
              ) : (
                <Image
                  src={item.image}
                  alt={item.alt[t.lang]}
                  widths={thumbWidths(item.image.width)}
                  sizes="(min-width: 1100px) 270px, (min-width: 640px) 31vw, 47vw"
                  loading="lazy"
                />
              )}
              {item.stage && (
                <span class:list={['tag', item.stage === 'healed' && 'tag--healed']}>
                  {t.portfolio.stages[item.stage]}
                </span>
              )}
            </button>
          </li>
        ))
      }
    </ul>

    {
      items.length > INITIAL_VISIBLE && (
        <button type="button" class="btn btn--ghost show-more" data-show-more hidden>
          {t.portfolio.showMore} ({items.length - INITIAL_VISIBLE})
        </button>
      )
    }

    <p class="note">{t.portfolio.healingNote}</p>

    <a
      class="btn btn--ghost more"
      href={site.instagram.profileUrl}
      target="_blank"
      rel="noopener"
      data-track="instagram_profile_click"
      data-track-location="portfolio"
    >
      <Icon name="instagram" />
      {t.cta.moreOnInstagram}
    </a>
  </div>

  <dialog class="lightbox" data-lightbox aria-label={t.portfolio.title}>
    <img alt="" data-lightbox-img />
    <video data-lightbox-video muted loop playsinline controls hidden></video>
    <button type="button" class="lb-btn lb-close" data-lightbox-close aria-label={t.portfolio.close}>×</button>
    <button type="button" class="lb-btn lb-prev" data-lightbox-prev aria-label={t.portfolio.prev}>‹</button>
    <button type="button" class="lb-btn lb-next" data-lightbox-next aria-label={t.portfolio.next}>›</button>
  </dialog>
</section>

<script>
  import { track } from '../scripts/track';

  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const lbImg = dialog?.querySelector<HTMLImageElement>('[data-lightbox-img]');
  const lbVideo = dialog?.querySelector<HTMLVideoElement>('[data-lightbox-video]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Wideo w galerii: gra tylko, gdy kafelek jest na ekranie.
  const inview = document.querySelectorAll<HTMLVideoElement>('[data-inview-video]');
  if (inview.length && 'IntersectionObserver' in window && !reduceMotion) {
    const io = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }),
      { threshold: 0.5 },
    );
    inview.forEach((v) => io.observe(v));
  }

  // „Pokaż więcej” — zwijamy nadmiarowe zdjęcia dopiero, gdy JS działa
  const showMore = document.querySelector<HTMLButtonElement>('[data-show-more]');
  const expand = () => {
    gallery?.classList.remove('is-collapsed');
    if (showMore) showMore.hidden = true;
  };
  if (showMore && gallery) {
    gallery.classList.add('is-collapsed');
    showMore.hidden = false;
    showMore.addEventListener('click', () => {
      expand();
      track('portfolio_show_more');
    });
  }

  // Filtry kategorii
  filters?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-filter]');
    if (!btn || !gallery) return;
    const f = btn.dataset.filter!;
    expand();
    filters.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    gallery.querySelectorAll<HTMLElement>('li').forEach((li) => {
      li.hidden = f !== 'all' && !li.dataset.categories!.split(' ').includes(f);
    });
    track('portfolio_filter', { category: f });
  });

  // Podgląd zdjęcia
  const visibleItems = () =>
    [...(gallery?.querySelectorAll<HTMLButtonElement>('li:not([hidden]) .gallery__item') ?? [])].filter(
      (b) => b.offsetParent !== null,
    );
  let current: HTMLButtonElement | null = null;

  const show = (btn: HTMLButtonElement) => {
    if (!dialog || !lbImg) return;
    current = btn;
    const mp4 = btn.dataset.videoMp4;
    if (mp4 && lbVideo) {
      lbImg.hidden = true;
      lbVideo.hidden = false;
      lbVideo.poster = btn.dataset.videoPoster ?? '';
      lbVideo.innerHTML = '';
      for (const [src, type] of [
        [mp4, 'video/mp4'],
        [btn.dataset.videoWebm, 'video/webm'],
      ]) {
        if (!src) continue;
        const s = document.createElement('source');
        s.src = src;
        s.type = type!;
        lbVideo.append(s);
      }
      lbVideo.setAttribute('aria-label', btn.dataset.alt!);
      lbVideo.load();
      if (!reduceMotion) lbVideo.play().catch(() => {});
    } else {
      lbVideo?.pause();
      if (lbVideo) lbVideo.hidden = true;
      lbImg.hidden = false;
      lbImg.src = btn.dataset.full!;
      lbImg.alt = btn.dataset.alt!;
      lbImg.style.maxWidth = `min(92vw, ${btn.dataset.max}px)`;
    }
  };
  const step = (dir: number) => {
    const list = visibleItems();
    if (!current || !list.length) return;
    const idx = list.indexOf(current);
    show(list[(idx + dir + list.length) % list.length]);
  };

  gallery?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.gallery__item');
    if (!btn || !dialog) return;
    show(btn);
    dialog.showModal();
    track('portfolio_open', { index: btn.dataset.index! });
  });
  dialog?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
  dialog?.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => step(-1));
  dialog?.querySelector('[data-lightbox-next]')?.addEventListener('click', () => step(1));
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog?.addEventListener('close', () => {
    lbVideo?.pause();
    current?.focus();
  });
  document.addEventListener('keydown', (e) => {
    if (!dialog?.open) return;
    if (e.key === 'ArrowLeft') step(-1);
    if (e.key === 'ArrowRight') step(1);
  });

  // Przesuwanie palcem na telefonie
  let startX = 0;
  dialog?.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
  dialog?.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);
  });
</script>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  .filters button {
    font: inherit;
    font-size: 0.9375rem;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .filters button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
  }
  @media (min-width: 640px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
  }
  @media (min-width: 1000px) {
    .gallery {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .gallery li[hidden],
  .gallery.is-collapsed li[data-extra] {
    display: none;
  }
  .show-more {
    margin-top: 16px;
    width: 100%;
  }
  .show-more[hidden] {
    display: none;
  }
  @media (min-width: 640px) {
    .show-more {
      width: auto;
    }
  }
  .gallery__item {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--surface);
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: zoom-in;
  }
  .gallery__item :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  @media (hover: hover) {
    .gallery__item:hover :global(img) {
      transform: scale(1.03);
    }
  }
  .tag {
    position: absolute;
    left: 8px;
    bottom: 8px;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
  }
  .tag--healed {
    background: var(--accent);
    color: var(--accent-ink);
  }
  .note {
    margin-top: 20px;
    font-size: 0.9375rem;
    color: var(--muted);
    max-width: 640px;
  }
  .more {
    margin-top: 8px;
    max-width: 100%;
    white-space: normal;
    text-align: center;
  }

  .lightbox {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    height: 100dvh;
  }
  .lightbox[open] {
    display: grid;
    place-items: center;
  }
  .lightbox::backdrop {
    background: rgba(20, 16, 14, 0.9);
  }
  .gallery__video {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
  }
  .play {
    position: absolute;
    top: 8px;
    right: 8px;
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    font-size: 0.65rem;
    padding-left: 2px;
  }
  .lightbox video {
    max-width: min(92vw, 420px);
    max-height: 86vh;
    border-radius: var(--radius-sm);
    background: #000;
  }
  .lightbox [hidden] {
    display: none;
  }
  .lightbox img {
    width: 100%;
    max-height: 86vh;
    object-fit: contain;
    border-radius: var(--radius-sm);
  }
  .lb-btn {
    position: fixed;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
  }
  .lb-close {
    top: 12px;
    right: 12px;
  }
  .lb-prev,
  .lb-next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-prev {
    left: 8px;
  }
  .lb-next {
    right: 8px;
  }
</style>
