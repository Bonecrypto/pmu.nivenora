---
import { locales, localeMeta, type Locale } from '../i18n/locales';
import Icon from './Icon.astro';

interface Props {
  current: Locale;
  label: string;
}
const { current, label } = Astro.props;
---

<nav class="lang" aria-label={label}>
  <Icon name="globe" class="lang__icon" />
  <ul>
    {
      locales.map((l) => (
        <li>
          <a
            href={localeMeta[l].path}
            hreflang={localeMeta[l].hreflang}
            lang={localeMeta[l].hreflang}
            title={localeMeta[l].name}
            aria-label={localeMeta[l].name}
            aria-current={l === current ? 'page' : undefined}
            data-lang-link={l}
            data-track="language_switch"
            data-track-location={l}
          >
            <span class="flag" aria-hidden="true">
              {l === 'pl' && (
                <svg viewBox="0 0 16 10" preserveAspectRatio="none">
                  <rect width="16" height="5" fill="#fff" />
                  <rect y="5" width="16" height="5" fill="#dc143c" />
                </svg>
              )}
              {l === 'uk' && (
                <svg viewBox="0 0 16 10" preserveAspectRatio="none">
                  <rect width="16" height="5" fill="#0057b7" />
                  <rect y="5" width="16" height="5" fill="#ffd700" />
                </svg>
              )}
              {l === 'en' && (
                <svg viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice">
                  <clipPath id="flag-gb-clip">
                    <path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" />
                  </clipPath>
                  <rect width="60" height="30" fill="#012169" />
                  <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
                  <path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#flag-gb-clip)" stroke="#c8102e" stroke-width="4" />
                  <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10" />
                  <path d="M30,0 v30 M0,15 h60" stroke="#c8102e" stroke-width="6" />
                </svg>
              )}
            </span>
            <span class="code">{localeMeta[l].short}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  // Zapamiętaj wybór — baner z propozycją języka nie pojawi się ponownie.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((a) =>
    a.addEventListener('click', () => {
      try {
        localStorage.setItem('lang-choice', a.dataset.langLink!);
      } catch {}
    }),
  );
</script>

<style>
  .lang {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .lang :global(.lang__icon) {
    width: 18px;
    height: 18px;
    color: var(--muted);
  }
  ul {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 3px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }
  a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    height: 32px;
    padding: 0 9px;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  a:hover {
    color: var(--ink);
  }
  a[aria-current='page'] {
    background: var(--ink);
    color: var(--bg);
  }
  .flag {
    display: block;
    width: 18px;
    height: 12px;
    border-radius: 2px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
    flex: none;
  }
  .flag svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  /* Flagi są wystarczająco czytelne — globus tylko na szerokich ekranach */
  .lang :global(.lang__icon) {
    display: none;
  }
  @media (min-width: 900px) {
    .lang :global(.lang__icon) {
      display: block;
    }
  }
  /* Bardzo wąskie ekrany: same flagi */
  @media (max-width: 374px) {
    .code {
      display: none;
    }
    a {
      padding: 0 8px;
    }
  }
</style>
