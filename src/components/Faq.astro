---
import type { Dictionary } from '../i18n/pl';
import { rich, plain } from '../i18n/rich';
interface Props {
  t: Dictionary;
  /** Wybrane pytania (domyślnie wszystkie). */
  items?: Dictionary['faq']['items'];
  title?: string;
  /** Ile pytań widać od razu; reszta po kliknięciu „Więcej pytań”. */
  initial?: number;
}
const { t, items = t.faq.items, title = t.faq.title, initial = 6 } = Astro.props;
const isDev = import.meta.env.DEV;

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: plain(i.a) },
  })),
};
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq">
    <div class="section-head">
      <h2 id="faq-title">{title}</h2>
    </div>
    <div class="faq__list">
      {
        items.map((item, i) => (
          <details data-extra={i >= initial ? '' : undefined}>
            <summary>{item.q}</summary>
            <div class="answer">
              {isDev && !item.verified && <p class="dev-flag">{t.dev.unverified}</p>}
              <p set:html={rich(item.a)} />
            </div>
          </details>
        ))
      }
    </div>
    {
      items.length > initial && (
        <button type="button" class="more" data-faq-more hidden>
          {t.faq.more} ({items.length - initial})
        </button>
      )
    }
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>

<script>
  // Zwijamy dodatkowe pytania dopiero, gdy JS działa (bez JS widać wszystkie).
  document.querySelectorAll<HTMLButtonElement>('[data-faq-more]').forEach((btn) => {
    const list = btn.parentElement?.querySelector<HTMLElement>('.faq__list');
    if (!list) return;
    list.classList.add('is-collapsed');
    btn.hidden = false;
    btn.addEventListener('click', () => {
      list.classList.remove('is-collapsed');
      btn.hidden = true;
    });
  });
</script>

<style>
  .faq__list {
    max-width: 760px;
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  .faq__list.is-collapsed details[data-extra] {
    display: none;
  }
  .more {
    margin-top: 12px;
    padding: 8px 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 600;
    color: var(--accent);
    cursor: pointer;
  }
  .more[hidden] {
    display: none;
  }
  summary {
    list-style: none;
    cursor: pointer;
    padding: 14px 40px 14px 0;
    position: relative;
    font-weight: 600;
    font-size: 1rem;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--accent);
    transition: transform 0.2s ease;
  }
  details[open] summary::after {
    transform: translateY(-50%) rotate(45deg);
  }
  .answer {
    padding: 0 0 18px;
    color: var(--muted);
  }
  .answer p:last-child {
    margin: 0;
  }
</style>
