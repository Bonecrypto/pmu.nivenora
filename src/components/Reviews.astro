---
import type { Dictionary } from '../i18n/pl';
import { reviews } from '../config/reviews';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const isDev = import.meta.env.DEV;
const serviceLabel = (s: string) =>
  s in t.portfolio.categories ? t.portfolio.categories[s as keyof typeof t.portfolio.categories] : '';
---

{
  reviews.length > 0 ? (
    <section class="section section--tint" id="opinie" aria-labelledby="opinie-title">
      <div class="container">
        <div class="section-head">
          <h2 id="opinie-title">{t.reviews.title}</h2>
        </div>
        <ul class="reviews">
          {reviews.map((r) => (
            <li>
              <blockquote>
                <p>„{r.text}”</p>
              </blockquote>
              <p class="meta">
                <strong>{r.author}</strong>
                {serviceLabel(r.service) && <> · {serviceLabel(r.service)}</>}
                {' · '}
                {r.sourceUrl ? (
                  <a href={r.sourceUrl} target="_blank" rel="noopener">
                    {r.source}
                  </a>
                ) : (
                  r.source
                )}
              </p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ) : (
    isDev && (
      <div class="container">
        <p class="dev-flag">{t.dev.reviewsHidden}</p>
      </div>
    )
  )
}

<style>
  .reviews {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  @media (min-width: 800px) {
    .reviews {
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 16px;
    }
  }
  .reviews li {
    background: var(--bg);
    border-radius: var(--radius);
    padding: 24px;
  }
  blockquote {
    margin: 0;
  }
  .meta {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
  }
</style>
