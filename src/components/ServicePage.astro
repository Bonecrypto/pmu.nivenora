---
/**
 * Strona jednej usługi (usta / brwi) — pod wyszukiwanie „makijaż permanentny ust/brwi Wrocław” i reklamy.
 * Usta mają w hero wideo przed/po, brwi — zdjęcie przed/po.
 */
import Layout from '../layouts/Layout.astro';
import Header from './Header.astro';
import Portfolio from './Portfolio.astro';
import Process from './Process.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import MobileCta from './MobileCta.astro';
import HealingTimeline from './HealingTimeline.astro';
import { Image } from 'astro:assets';
import ContactButton from './ContactButton.astro';
import ServiceInquiry from './ServiceInquiry.astro';
import { getDictionary, localeMeta, type Locale } from '../i18n';
import { rich } from '../i18n/rich';
import { prices, site } from '../config/site';
import { portfolio } from '../config/portfolio';

interface Props {
  locale: Locale;
  service: 'usta' | 'brwi';
}
const { locale, service } = Astro.props;
const t = getDictionary(locale);
const page = service === 'usta' ? 'lips' : 'brows';
const copy = service === 'usta' ? t.lips : t.brows;
const price = prices.pmu[service];
const serviceName = t.services.pmu[service].name;
const cur = t.services.currency;
const heroImage =
  portfolio.find((p) => p.categories.includes(service) && p.stage === 'before-after') ??
  portfolio.find((p) => p.categories.includes(service))!;
const heroVideo = heroImage.video;
// Pytania ogólne pasujące do ust (bez przygotowania i pielęgnacji — to Veronika wysyła indywidualnie).
const serviceJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: serviceName,
  serviceType: serviceName,
  description: copy.metaDescription,
  areaServed: { '@type': 'City', name: site.location.city },
  provider: { '@type': 'BeautySalon', name: site.brand, telephone: site.contact.phone ?? undefined, sameAs: [site.instagram.profileUrl] },
  offers: { '@type': 'Offer', price: price.price, priceCurrency: 'PLN' },
};
const faqItems = t.faq.items.filter((_, i) => [0, 1, 2, 3, 4, 5, 8, 9, 10].includes(i));
---

<Layout t={t} page={page} title={copy.metaTitle} description={copy.metaDescription}>
  <Header t={t} page={page} />
  <script type="application/ld+json" set:html={JSON.stringify(serviceJsonLd)} />
  <main id="main">
    <section class="lips-hero">
      <div class="container lips-hero__grid">
        <div>
          <p class="eyebrow">{copy.eyebrow}</p>
          <h1>{copy.title}</h1>
          <p class="lips-hero__lead" set:html={rich(copy.lead)} />
          <div class="price">
            <div>
              <span class="price__main">{price.price} <small>{cur}</small></span>
              <span class="price__corr">{t.services.correction}*: {price.correction} {cur}</span>
            </div>
            <p class="price__note">* {t.services.correctionNote(prices.correctionWithinMonths)}</p>
          </div>
          <div class="actions" data-hero-cta>
            <ServiceInquiry t={t} service={serviceName} id={`${page}-page`} variant="primary" />
            <ContactButton t={t} location="lips-hero" variant="ghost" />
          </div>
        </div>
        {
          heroVideo ? (
            /* Prawdziwe wideo przed / po (bez dźwięku, w pętli). */
            <video
              class="lips-hero__video"
              poster={heroVideo.poster}
              width="720"
              height="1280"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              aria-label={heroImage.alt[locale]}
              data-reduced-motion-pause
            >
              <source src={heroVideo.mp4} type="video/mp4" />
              {heroVideo.webm && <source src={heroVideo.webm} type="video/webm" />}
            </video>
          ) : (
            <Image
              src={heroImage.image}
              alt={heroImage.alt[locale]}
              widths={[...[360, 540].filter((x) => x < heroImage.image.width), Math.min(heroImage.image.width, 720)]}
              sizes="(min-width: 900px) 360px, 100vw"
              class="lips-hero__img"
              loading="eager"
              fetchpriority="high"
            />
          )
        }
      </div>
    </section>

    <section class="section section--tint" aria-labelledby="lips-points">
      <div class="container">
        <h2 id="lips-points">{copy.pointsTitle}</h2>
        <ol class="points">
          {
            copy.points.map((p, i) => (
              <li>
                <span class="num" aria-hidden="true">
                  0{i + 1}
                </span>
                <h3>{p.title}</h3>
                <p set:html={rich(p.text)} />
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <HealingTimeline t={t} />
    <Portfolio t={t} category={service} title={copy.galleryTitle} noVideo />
    <Process t={t} />
    <Faq t={t} items={faqItems} title={copy.faqTitle} />
    <Contact t={t} />
    <div class="container other">
      <a href={`${localeMeta[locale].path}#cennik`}>{copy.otherServices} →</a>
    </div>
  </main>
  <Footer t={t} />
  <MobileCta t={t} />
</Layout>

<script>
  // Osoby z włączonym „ogranicz ruch” — wideo zatrzymane (kadr jako podgląd).
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.querySelectorAll<HTMLVideoElement>('[data-reduced-motion-pause]').forEach((v) => {
      v.autoplay = false;
      v.pause();
    });
  }
</script>

<style>
  .lips-hero {
    padding-block: clamp(28px, 6vw, 72px) clamp(40px, 7vw, 80px);
  }
  .lips-hero__grid {
    display: grid;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .lips-hero__grid {
      grid-template-columns: 1.15fr 300px;
      align-items: start;
      gap: 64px;
    }
  }
  .lips-hero__lead {
    font-size: clamp(1.1rem, 2.6vw, 1.25rem);
    color: var(--muted);
    max-width: 36ch;
  }
  .lips-hero :global(.lips-hero__img) {
    display: block;
    width: 100%;
    max-width: 360px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    justify-self: center;
  }
  .lips-hero__video {
    display: block;
    width: 100%;
    max-width: 300px;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--surface);
    justify-self: center;
  }
  .price {
    margin: 24px 0;
    padding: 18px 20px;
    background: var(--surface);
    border-radius: var(--radius);
    max-width: 420px;
  }
  .price > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .price__main {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .price__main small {
    font-size: 1rem;
    color: var(--muted);
  }
  .price__corr {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .price__note {
    margin: 10px 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (max-width: 479px) {
    .actions > :global(*) {
      flex: 1 1 100%;
    }
  }
  .points {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 28px;
  }
  @media (min-width: 800px) {
    .points {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }
  .points li {
    border-top: 1px solid var(--ink);
    padding-top: 16px;
  }
  .num {
    display: block;
    font-family: var(--font-display);
    color: var(--accent);
    margin-bottom: 8px;
  }
  .points p {
    color: var(--muted);
    margin: 0;
  }
  .other {
    padding-block: 28px;
    text-align: center;
    font-weight: 600;
  }
</style>
