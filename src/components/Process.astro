---
import type { Dictionary } from '../i18n/pl';
import { rich } from '../i18n/rich';
interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section class="section section--tint" id="jak-to-wyglada" aria-labelledby="proces-title">
  <div class="container">
    <div class="section-head">
      <h2 id="proces-title">{t.process.title}</h2>
    </div>
    <ol class="steps">
      {
        t.process.steps.map((s, i) => (
          <li>
            <span class="step-num" aria-hidden="true">
              {i + 1}
            </span>
            <h3>{s.title}</h3>
            <p set:html={rich(s.text)} />
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Kafelki w stylu Apple: numer, krótki tytuł, jedna linijka */
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  @media (min-width: 800px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
  }
  .steps li {
    min-width: 0;
    overflow-wrap: break-word;
    hyphens: auto;
    background: var(--bg);
    border-radius: var(--radius);
    padding: 18px 16px;
  }
  .step-num {
    display: block;
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .steps h3 {
    font-size: 1.05rem;
    margin-bottom: 4px;
  }
  .steps p {
    margin: 0;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.4;
  }
</style>
