---
import type { Dictionary } from '../i18n/pl';
interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section class="section" id="jak-to-wyglada" aria-labelledby="proces-title">
  <div class="container">
    <div class="section-head">
      <h2 id="proces-title">{t.process.title}</h2>
      <p class="lead">{t.process.lead}</p>
    </div>
    <ol class="steps">
      {
        t.process.steps.map((s, i) => (
          <li>
            <span class="step-num" aria-hidden="true">
              {i + 1}
            </span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0 48px;
    max-width: 960px;
  }
  @media (min-width: 800px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  .steps li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .step-num {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    display: grid;
    place-items: center;
    font-weight: 600;
  }
  .steps h3 {
    font-size: 1.15rem;
    margin-bottom: 4px;
  }
  .steps p {
    margin: 0;
    color: var(--muted);
  }
</style>
