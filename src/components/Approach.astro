---
import type { Dictionary } from '../i18n/pl';
interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section class="section" aria-labelledby="podejscie-title">
  <div class="container">
    <div class="section-head">
      <h2 id="podejscie-title">{t.approach.title}</h2>
      <p class="lead">{t.approach.lead}</p>
    </div>
    <ol class="points">
      {
        t.approach.points.map((p, i) => (
          <li>
            <span class="num" aria-hidden="true">
              0{i + 1}
            </span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 28px;
  }
  @media (min-width: 800px) {
    .points {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }
  .points li {
    border-top: 1px solid var(--ink);
    padding-top: 16px;
  }
  .num {
    display: block;
    font-family: var(--font-display);
    color: var(--accent);
    font-size: 1.1rem;
    margin-bottom: 8px;
  }
  .points p {
    color: var(--muted);
    margin: 0;
  }
</style>
