---
import { Image } from 'astro:assets';
import type { Dictionary } from '../i18n/pl';
import { rich } from '../i18n/rich';
import Icon from './Icon.astro';
import veronikaPhoto from '../assets/veronika/veronika.jpg';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section class="section" id="o-mnie" aria-labelledby="o-mnie-title">
  <div class="container about">
    <Image
      src={veronikaPhoto}
      alt={t.about.photoAlt}
      widths={[400, 600, 846]}
      sizes="(min-width: 800px) 460px, calc(100vw - 32px)"
      class="about__photo"
      loading="lazy"
    />
    <div>
      <h2 id="o-mnie-title">{t.about.title}</h2>
      <p class="about__text" set:html={rich(t.about.text)} />
      <ul class="points">
        {
          t.about.points.map((p) => (
            <li>
              <Icon name="check" />
              {p}
            </li>
          ))
        }
      </ul>
      <p class="langs">
        <Icon name="globe" />
        <span>{t.about.languagesTitle} {t.about.languages.join(', ')}.</span>
      </p>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 24px;
  }
  .about :global(.about__photo) {
    width: 100%;
    max-width: 460px;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--radius);
  }
  @media (min-width: 800px) {
    .about {
      grid-template-columns: minmax(0, 460px) 1fr;
      gap: 64px;
      align-items: center;
    }
    .about :global(.about__photo) {
      aspect-ratio: 4 / 5;
    }
  }
  .about__text {
    font-size: 1.0625rem;
    max-width: 52ch;
  }
  .points {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .points li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
  }
  .points :global(svg) {
    flex: none;
    width: 22px;
    height: 22px;
    padding: 3px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .langs {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 20px 0 0;
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .langs :global(svg) {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 2px;
    color: var(--accent);
  }
</style>
