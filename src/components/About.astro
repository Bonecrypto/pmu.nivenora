---
import { Image } from 'astro:assets';
import type { Dictionary } from '../i18n/pl';
import veronikaPhoto from '../assets/veronika/veronika.jpg';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---

<section class="section" id="o-mnie" aria-labelledby="o-mnie-title">
  <div class="container about">
    <Image
      src={veronikaPhoto}
      alt={t.about.photoAlt}
      widths={[300, 600, 846]}
      sizes="(min-width: 800px) 420px, 150px"
      class="about__photo"
      loading="lazy"
    />
    <div>
      <h2 id="o-mnie-title">{t.about.title}</h2>
      {t.about.paragraphs.map((p) => <p>{p}</p>)}
      <p class="langs-title">{t.about.languagesTitle}</p>
      <ul class="langs">
        {t.about.languages.map((l) => <li>{l}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 20px;
  }
  @media (min-width: 800px) {
    .about :global(.about__photo) {
      width: 100%;
      max-width: 420px;
    }
    .about {
      grid-template-columns: 420px 1fr;
      gap: 56px;
      align-items: center;
    }
  }
  .about :global(.about__photo) {
    width: 150px;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 35%;
    border-radius: var(--radius);
  }
  .langs-title {
    margin: 24px 0 10px;
    font-weight: 600;
  }
  .langs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .langs li {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--surface);
    font-size: 0.9375rem;
  }
</style>
