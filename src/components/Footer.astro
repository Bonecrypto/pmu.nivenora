---
import type { Dictionary } from '../i18n/pl';
import { site } from '../config/site';
import { localeMeta } from '../i18n/locales';
interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p>
      <strong>{site.brand}</strong> · {t.footer.tagline}
    </p>
    <p class="links">
      <a href={site.instagram.profileUrl} target="_blank" rel="noopener" data-track="instagram_profile_click" data-track-location="footer"
        >@{site.instagram.handle}</a
      >
      <a href={localeMeta[t.lang].pages.privacy}>{t.footer.privacy}</a>
      <span>© {year}</span>
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 28px;
    font-size: 0.875rem;
    color: var(--muted);
  }
  .footer p {
    margin: 0 0 4px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
</style>
