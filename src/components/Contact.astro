---
import type { Dictionary } from '../i18n/pl';
import { site, whatsappUrl } from '../config/site';
import ContactButton from './ContactButton.astro';
import Icon from './Icon.astro';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const { location, contact, instagram } = site;
const waUrl = whatsappUrl(t.contact.whatsappMessage);
---

<section class="section section--tint" id="kontakt" aria-labelledby="kontakt-title">
  <div class="container contact">
    <div>
      <h2 id="kontakt-title">{t.contact.title}</h2>
      <p class="lead">{t.contact.lead}</p>
      <div class="actions">
        <ContactButton t={t} location="contact" />
        {
          contact.phone && (
            <a class="btn btn--ghost" href={`tel:${contact.phone.replace(/\s/g, '')}`} data-track="phone_click" data-track-location="contact">
              <Icon name="phone" />
              {t.contact.call}
            </a>
          )
        }
        {
          waUrl && (
            <a class="btn btn--ghost" href={waUrl} target="_blank" rel="noopener" data-track="whatsapp_click" data-track-location="contact">
              <Icon name="whatsapp" />
              {t.contact.whatsapp}
            </a>
          )
        }
      </div>
    </div>

    <div class="contact__info">
      <div class="block">
        <h3><Icon name="pin" /> {t.contact.locationTitle}</h3>
        <address>
          {
            location.streetAddress ? (
              <>
                {location.streetAddress}
                <br />
                {location.postalCode} {location.city}
              </>
            ) : (
              t.contact.addressLines.map((l, i) => (
                <>
                  {i > 0 && <br />}
                  {l}
                </>
              ))
            )
          }
        </address>
        {!location.streetAddress && <p class="small">{t.contact.addressNote}</p>}
        <dl class="facts">
          {
            contact.phone && (
              <div>
                <dt>{t.contact.phone}</dt>
                <dd>
                  <a href={`tel:${contact.phone.replace(/\s/g, '')}`} data-track="phone_click" data-track-location="contact-list">
                    {contact.phone}
                  </a>
                </dd>
              </div>
            )
          }
          <div>
            <dt>{t.contact.instagram}</dt>
            <dd>
              <a href={instagram.profileUrl} target="_blank" rel="noopener" data-track="instagram_profile_click" data-track-location="contact-list">
                @{instagram.handle}
              </a>
            </dd>
          </div>
          {
            contact.email && (
              <div>
                <dt>{t.contact.email}</dt>
                <dd>
                  <a href={`mailto:${contact.email}`} data-track="email_click">
                    {contact.email}
                  </a>
                </dd>
              </div>
            )
          }
        </dl>
        {
          location.mapsUrl && (
            <a href={location.mapsUrl} target="_blank" rel="noopener" data-track="map_click">
              {t.contact.map}
            </a>
          )
        }
      </div>

    </div>
  </div>
</section>

<style>
  .contact {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 800px) {
    .contact {
      grid-template-columns: 1fr 1fr;
      gap: 56px;
      align-items: start;
    }
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  /* Telefon: główny przycisk na całą szerokość, „Zadzwoń” i WhatsApp obok siebie */
  @media (max-width: 479px) {
    .actions {
      gap: 8px;
    }
    .actions > :global(*) {
      flex: 1 1 0;
      min-width: 0;
      padding: 0 12px;
      white-space: normal;
      text-align: center;
    }
    .actions > :global(:first-child) {
      flex-basis: 100%;
    }
  }
  .contact__info {
    display: grid;
    gap: 12px;
  }
  .block {
    background: var(--bg);
    border-radius: var(--radius);
    padding: 18px 20px;
  }
  .block h3 {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.1rem;
  }
  .block h3 :global(svg) {
    width: 20px;
    height: 20px;
    color: var(--accent);
  }
  address {
    font-style: normal;
  }
  .small {
    font-size: 0.9375rem;
    color: var(--muted);
    margin: 8px 0 0;
  }
  .facts {
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 6px;
  }
  .facts div {
    display: flex;
    justify-content: space-between;
    gap: 12px;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
    text-align: right;
  }
</style>
