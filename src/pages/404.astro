---
import Layout from '../layouts/Layout.astro';
import { getDictionary, defaultLocale, locales, localeMeta } from '../i18n';
const t = getDictionary(defaultLocale);
---

<Layout t={t} page="none" title={`404 | ${t.footer.notFoundTitle}`} noindex>
  <main id="main" class="container nf">
    {
      locales.map((l) => {
        const d = getDictionary(l);
        return (
          <section lang={localeMeta[l].hreflang}>
            <h1>{d.footer.notFoundTitle}</h1>
            <p class="lead">{d.footer.notFoundText}</p>
            <a class="btn btn--primary" href={localeMeta[l].path}>
              {d.footer.backHome}
            </a>
          </section>
        );
      })
    }
  </main>
</Layout>

<style>
  .nf {
    min-height: 80vh;
    display: grid;
    align-content: center;
    gap: 40px;
    padding-block: 48px;
  }
  .nf h1 {
    font-size: clamp(1.6rem, 5vw, 2.2rem);
  }
  :global(body) {
    padding-bottom: 0;
  }
</style>
