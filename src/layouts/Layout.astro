---
import '../styles/global.css';
import type { Dictionary } from '../i18n/pl';
import { site, prices } from '../config/site';
import { locales, localeMeta, defaultLocale, getDictionary, type PageId } from '../i18n';

interface Props {
  t: Dictionary;
  /** Która podstrona — do linków alternatywnych językowo (hreflang). */
  page?: PageId | 'none';
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { t, page = 'home', title = t.meta.title, description = t.meta.description, noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const alternates =
  page === 'none'
    ? []
    : locales.map((l) => ({ hreflang: localeMeta[l].hreflang, href: new URL(localeMeta[l].pages[page as PageId], Astro.site).href }));
// Obrazki podglądu linku generuje scripts/make-og.cjs → public/og/<lang>.jpg
const ogImageUrl = new URL(`/og/${t.lang}.jpg`, Astro.site).href;
// Opcjonalnie: Cloudflare Web Analytics (bez cookies) — token z panelu Cloudflare jako zmienna PUBLIC_CF_BEACON_TOKEN.
const cfBeaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
// Opcjonalnie: weryfikacja w Google Search Console (metoda „tag HTML”) — wartość content jako PUBLIC_GOOGLE_SITE_VERIFICATION.
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const allPrices = [
  ...Object.values(prices.pmu).map((p) => p.price),
  ...prices.pmuPackages.map((p) => p.price),
  ...prices.styling.flatMap((g) => g.items.map((i) => i.price)),
];

// Dane strukturalne dla Google (lokalny biznes). Bez adresu ulicy, dopóki nie jest zatwierdzony.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BeautySalon',
  name: site.brand,
  url: canonical,
  image: ogImageUrl,
  description: t.meta.description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.location.city,
    addressRegion: 'dolnośląskie',
    addressCountry: 'PL',
    ...(site.location.streetAddress ? { streetAddress: site.location.streetAddress } : {}),
    ...(site.location.postalCode ? { postalCode: site.location.postalCode } : {}),
  },
  areaServed: { '@type': 'City', name: site.location.city },
  knowsLanguage: ['pl', 'uk', 'ru', 'en'],
  sameAs: [site.instagram.profileUrl],
  priceRange: `${Math.min(...allPrices)}–${Math.max(...allPrices)} PLN`,
  currenciesAccepted: 'PLN',
  ...(site.contact.phone ? { telephone: site.contact.phone } : {}),
  ...(site.contact.email ? { email: site.contact.email } : {}),
  makesOffer: Object.entries(prices.pmu).map(([id, p]) => ({
    '@type': 'Offer',
    price: p.price,
    priceCurrency: 'PLN',
    itemOffered: { '@type': 'Service', name: t.services.pmu[id as keyof typeof t.services.pmu].name },
  })),
};
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {
      alternates.length > 0 && (
        <link rel="alternate" hreflang="x-default" href={new URL(localeMeta[defaultLocale].pages[page as PageId], Astro.site).href} />
      )
    }
    {noindex && <meta name="robots" content="noindex" />}
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <meta name="theme-color" content="#fbf8f4" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={t.locale} />
    {locales.filter((l) => l !== t.lang).map((l) => <meta property="og:locale:alternate" content={getDictionary(l).locale} />)}
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />

    {page === 'home' && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <slot />
    <script>
      import '../scripts/track';
    </script>
    {
      cfBeaconToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfBeaconToken })}
        />
      )
    }
  </body>
</html>
